@model IEnumerable<TP2.Models.Product>

@{
    ViewData["Title"] = "Liste des Produits";
}

<h1>Liste des produits</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Créer un nouveau produit</a>
</p>

<!-- Formulaire de recherche -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="term" class="form-control" placeholder="Rechercher par nom ou catégorie..." value="@Context.Request.Query["term"]" />
        <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
        <a asp-action="Index" class="btn btn-outline-dark ms-1">Réinitialiser</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Nom</th>
            <th>Prix (TND)</th>
            <th>Quantité</th>
            <th>Catégorie</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="~/images/@item.ImagePath" alt="Produit" class="img-thumbnail" style="max-height: 50px;" />
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.QteStock)</td>
                <td>@item.Category?.CategoryName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-warning btn-sm">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-danger btn-sm">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>